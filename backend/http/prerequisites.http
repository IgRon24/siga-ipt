    client.test("201 Created", () => client.assert(response.status === 201));
%}

### 5. Crear asignatura TAP202 (semestre 2, mismo semestre que TAP201) -> espera 201
POST {{baseUrl}}/api/subjects
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "code": "TAP202{{run}}",
  "name": "Bases de Datos",
  "semester": 2,
  "telTheory": 2,
  "telExercises": 2,
  "telLab": 2,
