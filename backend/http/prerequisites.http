    client.test("201 Created", () => client.assert(response.status === 201));
%}

### ---------------------------------------------------------------
### CASOS FELICES
### ---------------------------------------------------------------

### 6. TAP101 (sem 1) como prerrequisito de TAP201 (sem 2) -> espera 201
POST {{baseUrl}}/api/subjects/{{tap201}}/prerequisites
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "prerequisiteSubjectId": {{tap101}}
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201));
    client.test("devuelve el codigo del prerrequisito", () =>
        client.assert(response.body.prerequisiteSubjectCode.startsWith("TAP101")));
%}

### 7. Listar los prerrequisitos de TAP201 -> espera 200 con 1 elemento
GET {{baseUrl}}/api/subjects/{{tap201}}/prerequisites
Authorization: Bearer {{adminToken}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
    client.test("tiene 1 prerrequisito", () => client.assert(response.body.length === 1));
%}

### 8. Listar los prerrequisitos de TAP101 -> espera 200 con lista vacia
GET {{baseUrl}}/api/subjects/{{tap101}}/prerequisites
Authorization: Bearer {{adminToken}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
    client.test("lista vacia", () => client.assert(response.body.length === 0));
%}

### ---------------------------------------------------------------
### CASOS DE RECHAZO (reglas de negocio -> 409)
### ---------------------------------------------------------------

### 9. Repetir el mismo prerrequisito -> espera 409 "already has"
POST {{baseUrl}}/api/subjects/{{tap201}}/prerequisites
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "prerequisiteSubjectId": {{tap101}}
}

> {%
    client.test("409 Conflict", () => client.assert(response.status === 409));
%}

### 10. Prerrequisito del MISMO semestre (TAP202 sem 2 sobre TAP201 sem 2) -> espera 409
POST {{baseUrl}}/api/subjects/{{tap201}}/prerequisites
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "prerequisiteSubjectId": {{tap202}}
}

> {%
    client.test("409 Conflict", () => client.assert(response.status === 409));
%}

