# Plantilla de las variables que el backend lee al correr en local (sin Docker).
# Este archivo SI se versiona, por eso no lleva credenciales reales. El archivo
# con los valores de verdad es .env, que esta en .gitignore.
#
#   cp .env.example .env     y completar lo de abajo
#
# application.properties lo carga con spring.config.import=optional:file:.env,
# que es una ruta relativa: hay que arrancar la app con backend/ como
# directorio de trabajo (./mvnw spring-boot:run desde aqui ya lo hace).
#
# Esto es solo para el modo local contra el PostgreSQL de localhost:5432. En
# Docker Compose las mismas dos variables salen del .env de la raiz
# (POSTGRES_USER / POSTGRES_PASSWORD), asi que este archivo no se usa.

# --- Base de datos (jdbc:postgresql://localhost:5432/siga_db) ---
DB_USERNAME=postgres
DB_PASSWORD=
