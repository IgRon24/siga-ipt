# Copiar como .env y ajustar. Vite solo expone las variables con prefijo VITE_.

# Opcion recomendada en desarrollo: rutas relativas resueltas por el proxy de
# vite.config.js, que evita CORS tanto en el backend como en Keycloak.
VITE_API_URL=/api
VITE_KC_URL=/auth

# Alternativa sin proxy (exige CORS en Spring y los Web Origins del client):
# VITE_API_URL=http://localhost:8080/api
# VITE_KC_URL=http://localhost:8081

VITE_KC_REALM=siga-realm

# El client de Keycloak con "Direct access grants" habilitado; es el mismo
# KC_CLIENT_ID que usan los scripts de prueba de backend/http.
VITE_KC_CLIENT_ID=siga-frontend

# Solo si el client es confidencial; un SPA deberia usar uno publico y dejarlo vacio.
VITE_KC_CLIENT_SECRET=
