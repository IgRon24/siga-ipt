# Plantilla de las variables de docker-compose.yml. Este archivo SI se versiona,
# por eso no lleva credenciales reales. El archivo con los valores de verdad es
# .env, que esta en .gitignore.
#
#   cp .env.example .env     y completar lo de abajo

# --- Base de datos ---
POSTGRES_DB=siga_db
POSTGRES_USER=siga
POSTGRES_PASSWORD=
# Ojo: Postgres fija esta clave al crear el volumen. Si la cambias despues,
# hay que recrearlo (docker compose down -v) o seguira pidiendo la anterior.

# --- Keycloak ---
# Admin de la consola, en <PUBLIC_URL>/auth/admin. En un despliegue publico
# esta consola queda expuesta: usar una clave larga, no "admin".
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KC_REALM=siga-realm
KC_CLIENT_ID=siga-frontend

# --- Publicacion ---
# URL publica con la que el navegador llega al sistema. Define el issuer de los
# tokens, asi que Keycloak y el backend la toman de aqui los dos a la vez.
#   local:  http://localhost
#   AWS:    http://<ip-publica-o-dns-de-la-instancia>
PUBLIC_URL=http://localhost
PUBLIC_PORT=80

# --- Rendimiento ---
# Conexiones a la base por replica del backend (HikariCP). El total, replicas
# por pool, tiene que quedar bajo el max_connections de Postgres (100):
# 2 replicas x 25 = 50, 3 x 25 = 75. Con el defecto de Hikari (10) el pool es
# el primer cuello de botella bajo carga; ver perf/README.md.
DB_POOL_SIZE=25

# --- Imagenes ---
# Usuario de Docker Hub donde viven siga-backend y siga-frontend
DOCKERHUB_USER=
TAG=latest
